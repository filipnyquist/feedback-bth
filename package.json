{
  "name": "feedback-bth",
  "scripts": {
    "dev": "concurrently \"bun run backend:dev\" \"bun run frontend:dev\"",
    "backend:dev": "cd backend && bun run --watch src/index.ts",
    "frontend:dev": "cd frontend && bun run dev",
    "db:migrate": "cd backend && bun run src/migrate.ts",
    "build": "cd frontend && bun run build"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
